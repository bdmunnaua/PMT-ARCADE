# ---------------------------------------------------------------------------
# Web app (read by Vite at build/dev time). Copy to ".env" in this folder.
# EXTERNAL SETUP REQUIRED: values come from Firebase console → Project settings
# → General → Your apps → Web app → SDK setup and configuration. Use the SAME
# Firebase project as the host app this platform is merged into: this app has no
# login/registration screens and only reads that app's sign-in session.
# The Firebase web API key is NOT a secret (it identifies the project), but keep
# this file out of git anyway.
# ---------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id

# Optional: the host app's sign-in page. Signed-out visitors get a "Go to sign in"
# button linking here with ?redirect=<current url>.
VITE_LOGIN_URL=

# Local development only: pick test players without Firebase (each browser tab
# can be a different player). Ignored by production builds. Needs DEV_AUTH=true
# in apps/api/.dev.vars as well.
VITE_DEV_AUTH=false

# Optional: only when the web app is hosted on a different origin than the API
# (leave empty when the Worker serves both — the default).
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Worker (API) configuration lives in apps/api/wrangler.jsonc ("vars") and
# secrets in apps/api/.dev.vars (local) / `wrangler secret put` (production):
#   ENVIRONMENT                  development | production
#   FIREBASE_PROJECT_ID          same project id as above
#   FIREBASE_API_KEY             (informational; not used for verification)
#   FIREBASE_AUTH_DOMAIN         (informational)
#   ALLOWED_ORIGINS              comma-separated origins allowed by CORS
#   ADMIN_REQUIRE_VERIFIED_EMAIL "true" in production
#   DEV_AUTH                     "true" accepts dev.<name> test identities — only when
#                                ENVIRONMENT=development (put it in .dev.vars, never production)
#   RATE_LIMIT_OVERRIDES         optional JSON, e.g. {"buy_create":{"limit":3,"windowSec":3600}}
#   REALTIME_TICKET_SECRET       secret, ≥ 32 random characters
#   INTERNAL_API_SECRET          secret, ≥ 32 random characters (external game servers)
# ---------------------------------------------------------------------------
